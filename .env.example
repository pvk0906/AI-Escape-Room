# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#   cp .env.example .env

# Which backend to use:
#   gemini  - Google Gemini API (needs GEMINI_API_KEY)
#   openai  - any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama, ...)
#   none    - no LLM. Version 2 still runs (rule-based parser + template text);
#             Version 1 cannot run without an LLM.
LLM_PROVIDER=gemini

# ---- Gemini -------------------------------------------------------------
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# "gemini-flash-latest" is an alias that follows the current Flash model.
# If you get a 404 "model not found", look up a current model name in AI Studio.
GEMINI_MODEL=gemini-flash-latest

# ---- OpenAI-compatible (used when LLM_PROVIDER=openai) -------------------
# Examples:
#   Ollama (local, no key):  http://localhost:11434/v1   model e.g. llama3.2
#   Groq:                    https://api.groq.com/openai/v1
#   OpenRouter:              https://openrouter.ai/api/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama3.2
